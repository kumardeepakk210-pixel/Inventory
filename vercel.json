{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/api",
      "destination": "/api/index.js"
    },
    {
      "source": "/inventory",
      "destination": "/index.html"
    },
    {
      "source": "/inventory/",
      "destination": "/index.html"
    }
  ]
}
