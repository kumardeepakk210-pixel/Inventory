# ==============================================================================
# WISHRITE INVENTORY — SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your actual credentials.
# NEVER commit the live .env file to Git!
# ==============================================================================

# Supabase Project Credentials (Server-side ONLY — Never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key-here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-supabase-publishable-key-here
# Legacy Compatibility Keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API Server Port
PORT=8085

# Allowed CORS Origins (Comma-separated for multiple origins in development)
CORS_ORIGIN=http://localhost:8085,http://127.0.0.1:8085

# Google Gemini AI Product Image Generator (Server-side ONLY — Never expose to browser)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here
# Supported models: gemini-3.1-flash-image (default, 4K native output), gemini-3-pro-image
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 8K Master Upscaler Provider Configuration
# Supported providers: sharp-lanczos-unsharp (default local high-precision), replicate, stability, fal, custom-api
UPSCALE_PROVIDER=sharp-lanczos-unsharp
# Required only if using an external cloud upscaler provider (e.g. Replicate, Stability AI)
UPSCALE_API_KEY=

# ==============================================================================
# RazorpayX Payout Configuration (Server-side ONLY — Creator Club Withdrawals)
# ==============================================================================
RAZORPAYX_MODE=sandbox
ALLOW_LIVE_PAYOUTS=false
RAZORPAYX_KEY_ID=rzp_test_your-sandbox-key-id
RAZORPAYX_KEY_SECRET=your-sandbox-key-secret
RAZORPAYX_ACCOUNT_NUMBER=7878780080316316
RAZORPAYX_WEBHOOK_SECRET=your-sandbox-webhook-secret
