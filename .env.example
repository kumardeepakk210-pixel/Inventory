# ==============================================================================
# WISHRITE INVENTORY — SERVER ENVIRONMENT CONFIGURATION
# Copy this file to .env and provide your actual credentials.
# NEVER commit the live .env file to Git!
# ==============================================================================

# Supabase Project Credentials (Server-side ONLY — Never expose to browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-supabase-secret-key-here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-supabase-publishable-key-here
# Legacy Compatibility Keys
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# API Server Port
PORT=8085

# Allowed CORS Origins (Comma-separated for multiple origins in development)
CORS_ORIGIN=http://localhost:8085,http://127.0.0.1:8085
